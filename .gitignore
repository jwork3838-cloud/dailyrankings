# ========================================
# Project-Specific Files (dailycell1.py)
# ========================================
# Ignore the cache directory and all its contents
mlb_cache/

# Ignore the trained models directory and all its contents
mlb_models/

# Ignore filelock files created during caching
*.lock

# ========================================
# Python Standard
# ========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# ========================================
# Environments & Secrets
# ========================================
# Ignore local environment variables (if you test locally)
.env
.env.local

# Virtual environments
.venv/
venv/
env/
ENV/

# ========================================
# Data & Machine Learning
# ========================================
# Ignore pickle files (just in case they end up outside the model/cache folders)
*.pkl

# Ignore local CSVs or JSONs if you ever download them for testing
*.csv
*.dat

# Jupyter Notebook checkpoints (if you ever test code in notebooks)
.ipynb_checkpoints/

# ========================================
# OS & IDE Files
# ========================================
# macOS
.DS_Store

# Windows
Thumbs.db

# VS Code
.vscode/

# PyCharm / IntelliJ
.idea/
